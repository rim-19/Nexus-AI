# Copy to .env and fill in. NEVER commit .env.

# --- AI provider keys ---
GROQ_API_KEY=              # console.groq.com/keys  (primary generation)
JINA_API_KEY=              # jina.ai  (embeddings + reranker)
GEMINI_API_KEY=            # aistudio.google.com/apikey  (optional fallback)
COHERE_API_KEY=            # optional rerank fallback
GITHUB_TOKEN=              # optional: private repos + higher rate limits

# --- database (Supabase pooler, Session mode) ---
# Supabase -> Connect -> Connection pooling -> Session. Username is postgres.<project-ref>.
DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- provider selection ---
LLM_PROVIDER=groq          # groq | gemini
EMBED_PROVIDER=jina        # jina | gemini
RERANK_PROVIDER=jina       # jina | cohere

# --- models ---
GROQ_MODEL_PRIMARY=qwen/qwen3.6-27b
GROQ_MODEL_FALLBACKS=openai/gpt-oss-120b,llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-pro

# --- auth / sessions ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# --- cookies / CORS ---
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false        # true in production (HTTPS)
COOKIE_SAMESITE=lax        # "none" (+ COOKIE_SECURE=true) for cross-site prod

# --- email (dev: reset/verify links are logged; wire a provider for production) ---
EMAIL_ENABLED=false
APP_BASE_URL=http://localhost:3000
